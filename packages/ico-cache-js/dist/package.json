        "yaml": "^2.0.0"
    },
    "devDependencies": {
        "typescript": "^5.0.0",
        "vitest": "^2.0.0",
        "@types/node": "^22.0.0",
        "@types/fs-extra": "^11.0.0",
        "@types/inquirer": "^9.0.0"
    }
