# Real-world RAG Demo Environment Configuration

# Service Ports & Hosts
RAG_API_PORT=8000
RAG_API_HOST=0.0.0.0
TENANT_ID=production-tenant

# Paths
DOCUMENTS_DIR=documents
DATA_DIR=data
LANCE_DB_DIR=data/lancedb
CACHE_DB_PATH=data/cache.db

# Embedding Configuration
# Options: fastembed, sentence-transformers, ollama, mock
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Vector Store
# Options: lancedb, qdrant
VECTOR_STORE_BACKEND=lancedb
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_corpus

# Retrieval Parameters
RETRIEVAL_TOP_K=4
RETRIEVAL_SIMILARITY_THRESHOLD=0.35

# ICO-Cache Toggles & Gateway
ENABLE_ICO_CACHE=true
ICO_GATEWAY_URL=http://localhost:8080/v1
ENABLE_L0_CACHE=true
ENABLE_L1_CACHE=true
ENABLE_L2_CACHE=true
ENABLE_L4_CACHE=true
ENABLE_L5_CACHE=true

# LLM Configuration
# Options: mock, openai, ollama, gemini
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# OpenAI-compatible streaming (e.g. NVIDIA NIM). Used by /v1/playground/stream
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_TOP_P=0.95
LLM_MAX_TOKENS=16384
LLM_ENABLE_THINKING=true
